---
import Charactersheet from "./Charactersheet.astro"
import Race from "../components/Race.astro"
const baseURL =  'https://www.dnd5eapi.co'

// Get race 
const endpointRace = '/api/2014/races/'
const raceURL = baseURL + endpointRace

const responseRace = await fetch(raceURL)
const DnDRaceData = await responseRace.json();
const DnDRaces = DnDRaceData.results


const DnDRace = Astro.url.searchParams.get("DnDRace");

// Get chosen race
const chosenRace = DnDRaces.find((raceItem) => raceItem.name === DnDRace);

let chosenRaceData = {}; 
let chosenRaceTraits = [];
let chosenRaceIndex = "";

if(chosenRace) {
	const chosenRaceEndpoint = chosenRace.url
	const chosenRaceURL = baseURL + chosenRaceEndpoint

	const chosenRaceResponse = await fetch(chosenRaceURL)
	chosenRaceData = await chosenRaceResponse.json();
    chosenRaceTraits = chosenRaceData.traits || [];
    chosenRaceIndex = chosenRace.index;
	console.log(chosenRaceData)
    console.log(chosenRaceTraits)
}


// Get traits
const endpointTraits = '/api/2014/traits/'

const traitURL = baseURL + endpointTraits

const responseTraits = await fetch(traitURL)
const traitData = await responseTraits.json();
const traits = traitData.results



// console.log(traits)
const endpointProficiencies = chosenRaceIndex ? `/api/2014/races/${chosenRaceIndex}/proficiencies` : null;

let proficiencies = [];

if(endpointProficiencies) {
        const profURL = baseURL + endpointProficiencies
        const responseProf = await fetch(profURL)
        const profData = await responseProf.json();
        proficiencies = profData.results || [];
}

// console.log("proficiencies", proficiencies)




// subrace data
let subraceTraits = [];
if (chosenRaceData?.subraces?.length > 0) {
    const subraceEndpoint = chosenRaceData.subraces[0].url

    console.log("subraces", subraceEndpoint)
    const subraceURL = baseURL + subraceEndpoint
    console.log(subraceURL)
    const subraceResponse = await fetch(subraceURL)
    const subraceData = await subraceResponse.json();
    

    console.log(subraceData)

    subraceTraits = subraceData.racial_traits

}


// languages 

const languages = chosenRaceData.languages || [];
console.log(languages)



---

<div class="selectable-content">
    <h2 id="tablist-1">Make your character</h2>

    <div class="tabs">
        <div role="tablist" aria-labelledby="tablist-1" class="manual">
            <div class="bookmark-container">
                <div class="triangle-container">
                    <div class="triangle"></div>
                    <div class="triangle2"></div>
                </div>
                <button id="tab-1" type="button" role="tab" aria-selected="true" aria-controls="tabpanel-1">
                    General Info
                </button>
            </div>
            <div class="bookmark-container">
                <div class="triangle-container">
                    <div class="triangle"></div>
                    <div class="triangle2"></div>
                </div>
                <button id="tab-2" type="button" role="tab" aria-selected="false" aria-controls="tabpanel-2">
                    Race
                </button>
            </div>
        </div>
    </div>
    
    <form action="/" method="GET" class="build-character is-hidden" id="tabpanel-1" role="tabpanel" aria-labelledby="tab-1">
        <div class="name-inputs">
            <label>
                Player Name
                <input type="text" id="player-name">
            </label>
            <label>
                Character Name
                <input type="text" id="character-name">
            </label>
        </div>
    </form>
    
    <form action="/" method="GET" class="build-character" id="tabpanel-2" role="tabpanel" aria-labelledby="tab-2">
        <Race raceRace={chosenRace} chosenRaceData={chosenRaceData} DnDRaces={DnDRaces} traits={chosenRaceTraits} />
    </form>


    <div>
                <ul>
                    {traits.map((trait) => (
                    <li>
                        <a href={`/traits/${trait.index}`}>
                        {trait.name}
                        </a>
                    </li>
                    ))}
                </ul>
            </div>

</div>

<Charactersheet chosenRaceData={chosenRaceData} traits={chosenRaceTraits} proficiencies={proficiencies} subraceTraits={subraceTraits} languages={languages}/>


<script>
    const raceSelect = document.getElementById("DnDRace");
    const form = raceSelect.closest("form"); 

    // Set the saved race on page load
    const savedRace = localStorage.getItem("selectedRace") || "";
    raceSelect.value = savedRace;

    // Submit form when race is selected
    raceSelect.addEventListener("change", function() {
        localStorage.setItem("selectedRace", raceSelect.value);
        form.submit();
    });

    // if the selected Race is not the same as the url, reload page with URL
    const urlParams = new URLSearchParams(window.location.search);
    const urlRace = urlParams.get("DnDRace");

    if(savedRace && savedRace !== urlRace) {
        form.submit();
    }

  
</script>