---
const { traitData } = Astro.props;

---

<div id="traitPage" class="book">

    <div class="page1">
        <h2>Description</h2>
        <p>{traitData.desc}</p>
    </div>

    <div class="page2">
        <h2>Which races have this trait</h2>
        <ul>
            {traitData.races.map((race) => <li>{race.name}</li>)}
            {traitData.subraces.length > 0 && (
                <>
                
                    {traitData.subraces.map((subrace) => (
                    <li>
                        {subrace.name}
                    </li>
                    ))}
                
                </>
            )}
        </ul>
    </div>
    
</div>

