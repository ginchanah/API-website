			<select name="DnDRace" id="DnDRace">
				{DnDRaces.map((DnDRace) => <option value={DnDRace.name}>{DnDRace.name}</option>)}
			</select>


			<!-- Choose Subrace is there is a subrace -->
			{chosenRaceData?.subraces?.length > 0 && (
			<div>
				<h2>Subrace</h2>
				<label for="subrace">Choose a subrace:</label>
				<select name="subrace" id="subrace">
				{chosenRaceData.subraces.map((subrace) => (<option value={subrace.name}>{subrace.name}</option>))}
				</select>
			</div>
			)}


